{
  "name": "shooter-z-fps",
  "private": true,
  "version": "0.1.0",
  "description": "Shooter Z: a laser-tag first-person shooter against AI robots (BULSHY.FM build). Can you beat AI?",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc",
    "speed": "tsx src/headless/speed.ts",
    "match": "tsx src/headless/match.ts",
    "replay": "tsx src/headless/replay.ts",
    "server": "tsx src/headless/server.ts",
    "deploy": "sst deploy --stage prod",
    "refresh": "sst refresh --stage prod"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.19.1",
    "@types/three": "^0.181.0",
    "playwright": "1.56.1",
    "sst": "4.17.2",
    "three": "^0.181.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "onnxruntime-web": "1.23.2"
  }
}
