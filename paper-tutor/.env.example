# Copy to .env.local (gitignored) and fill in. Never commit real values: this repo is public.

# Claude: the paper maps, the overview and the tutor.
ANTHROPIC_API_KEY=
# OpenAI text-to-speech for the tutor's voice.
OPENAI_API_KEY=

# Dev only (ignored in production builds): pretend a user is signed in, so everything works without any login.
PAPER_TUTOR_DEV_USER=1

# Login (only to try the real login locally; with the dev user above you don't need any of this).
# Option "www": ask the site that runs the login who is signed in (production uses this; no WorkOS keys here).
# AUTH_MODE=www
# WWW_ME_URL=http://localhost:3100/api/me
# Or WorkOS AuthKit in this app, with the same keys as the login site:
# WORKOS_CLIENT_ID=
# WORKOS_API_KEY=
# WORKOS_COOKIE_PASSWORD=
# NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3100/callback
# Where sign-in pages live (the login site). Locally: its dev server.
NEXT_PUBLIC_AUTH_ORIGIN=http://localhost:3100

# Optional: where the local store keeps papers, figures and voice files (default .data/ next to this file).
# PAPER_TUTOR_DATA_DIR=
# Optional: extra origins allowed to open the dev server (e.g. a phone on your network), comma-separated.
# DEV_ORIGINS=
# Optional: the AI + voice spend cap per month in dollars (default 50).
# SPEND_CAP_USD=

# Deploying (read by sst.config.ts from a gitignored .env): the ACM certificate for your domain, and who gets
# the AWS budget emails.
# PAPERS_CERT_ARN=
# BUDGET_EMAIL=
