# Copy to .env.local (gitignored) and fill in. Never commit real values: this repo is public.

# Claude: the structure pass (and, later, the live tutor).
ANTHROPIC_API_KEY=
# OpenAI text-to-speech for the tutor's voice.
OPENAI_API_KEY=

# Login: WorkOS AuthKit, shared with www.theonlygoatsan.com. Login is off when these are missing.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3100/callback
# Where sign-in lives (the personal site). Locally: the personal site's dev server.
NEXT_PUBLIC_AUTH_ORIGIN=http://localhost:3100

# Dev only (ignored in production builds): pretend a user is signed in, so actions work without WorkOS.
PAPER_TUTOR_DEV_USER=1

# Optional: where the local store keeps papers, figures and voice files (default .data/ next to this file).
# PAPER_TUTOR_DATA_DIR=
